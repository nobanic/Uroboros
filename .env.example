# Docker deployment config (copy to .env)
UROBOROS_TAG=latest
POSTGRES_USER=uroboros
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=uroboros

# LLM (fill in one or both; may also be left blank and configured in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
UROBOROS_LLM_PROVIDER=
UROBOROS_LLM_MODEL=
UROBOROS_LLM_BASE_URL=
UROBOROS_LLM_PROXY=

# T6C read-only Tor research is enabled by default. Docker Compose builds the
# pinned client-only sidecar locally; these values are optional build overrides.
UROBOROS_TOR_IMAGE=uroboros/tor-research:0.4.9.14
UROBOROS_TOR_VERSION=0.4.9.14-0+deb13u1
# The endpoint stays host-owned and is never returned to agents or the settings
# API. Native (non-Compose) deployments must provide an equivalent sidecar.
UROBOROS_TOR_SOCKS_URL=socks5://tor-research:9050
