{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uroboros:runtime-evidence:v1",
  "title": "Uroboros runtime evidence graph batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "manifest", "nodes", "edges", "summary"],
  "properties": {
    "format": {"const": "uroboros-runtime-evidence-v1"},
    "manifest": {"$ref": "#/$defs/manifest"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id", "tool", "target", "scope", "started_at", "finished_at", "exit_reason", "budgets",
        "identity_refs", "config_sha256", "corpus_sha256", "browser_version", "external_egress", "coverage",
        "truncated", "limitations", "adapter", "input_artifact"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "sha256", "source", "license"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 128},
            "version": {"type": "string", "minLength": 1, "maxLength": 128},
            "sha256": {"$ref": "#/$defs/sha256"},
            "source": {"type": "string", "format": "uri"},
            "license": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "revision"],
          "properties": {
            "origin": {"type": "string", "format": "uri"},
            "revision": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origins"],
          "properties": {
            "origins": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "format": "uri"}
            }
          }
        },
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "exit_reason": {"enum": ["completed", "budget_exhausted", "timeout", "cancelled", "interrupted", "error"]},
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_requests", "max_seconds", "max_concurrency"],
          "properties": {
            "max_requests": {"type": "integer", "minimum": 1},
            "max_seconds": {"type": "integer", "minimum": 1},
            "max_concurrency": {"type": "integer", "minimum": 1}
          }
        },
        "identity_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "corpus_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "browser_version": {"type": ["string", "null"], "maxLength": 128},
        "external_egress": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri"}
        },
        "coverage": {"type": "object"},
        "truncated": {"type": "boolean"},
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 128},
            "version": {"type": "string", "minLength": 1, "maxLength": 32}
          }
        },
        "input_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["media_type", "sha256", "bytes", "records"],
          "properties": {
            "media_type": {"type": "string", "minLength": 1, "maxLength": 128},
            "sha256": {"$ref": "#/$defs/sha256"},
            "bytes": {"type": "integer", "minimum": 0},
            "records": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "classification", "data"],
      "properties": {
        "id": {"type": "string", "pattern": "^n:[0-9a-f]{64}$"},
        "kind": {
          "enum": [
            "tool_run", "endpoint", "experiment", "request_observation", "response_observation",
            "coverage_observation", "oast_payload", "oast_callback", "hypothesis"
          ]
        },
        "classification": {"enum": ["observation", "derived_candidate", "hypothesis"]},
        "data": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "hypothesis"}}},
          "then": {"properties": {"classification": {"const": "hypothesis"}}},
          "else": {"properties": {"classification": {"not": {"const": "hypothesis"}}}}
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source", "target", "data"],
      "properties": {
        "id": {"type": "string", "pattern": "^e:[0-9a-f]{64}$"},
        "kind": {
          "enum": ["derived_from", "observed_at", "response_to", "transitions_to", "probes", "supports", "callback_for"]
        },
        "source": {"type": "string", "pattern": "^n:[0-9a-f]{64}$"},
        "target": {"type": "string", "pattern": "^n:[0-9a-f]{64}$"},
        "data": {"type": "object"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records", "ignored_records", "node_counts", "edge_counts", "claims", "details"],
      "properties": {
        "records": {"type": "integer", "minimum": 0},
        "ignored_records": {"type": "integer", "minimum": 0},
        "node_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "edge_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observations", "derived_candidates", "hypotheses", "findings"],
          "properties": {
            "observations": {"type": "integer", "minimum": 0},
            "derived_candidates": {"type": "integer", "minimum": 0},
            "hypotheses": {"type": "integer", "minimum": 0},
            "findings": {"const": 0}
          }
        },
        "details": {"type": "object"}
      }
    }
  }
}
