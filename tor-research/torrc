# Uroboros T6C is a client-only, read-only research egress. This process is not
# a relay, exit, bridge or onion service and exposes no ControlPort.
ClientOnly 1
ORPort 0
DirPort 0
BridgeRelay 0
ExitRelay 0
PublishServerDescriptor 0

# The fixed address exists only on the internal app<->Tor network. Mandatory
# SOCKS authentication is supplied by the broker and isolates each task.
SocksPort 172.30.61.2:9050 IsolateSOCKSAuth
SocksPolicy accept 172.30.61.0/24
SocksPolicy reject *
SafeSocks 1
TestSocks 1
ClientRejectInternalAddresses 1
AutomapHostsOnResolve 0

RunAsDaemon 0
AvoidDiskWrites 1
DataDirectory /var/lib/tor
PidFile /run/tor/tor.pid
Log notice stdout
