/uroboros.new
/uroboros.new.sha256
/uroboros.old
/uroboros.failed
/uroboros.upgrade.json
/server/webui/dist/
/dist/

# JWT signing key (generated at runtime, stored in the project root, never committed)
/jwt.key

# Local environment generated by Docker deployment (contains passwords/keys, not committed)
.env

# Event logs produced by scheduler runs/simulations (test artifacts, not committed)
*-events.csv

# bench benchmark-related (local artifacts, not committed)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2

# Local build output and private runtime material
web/out/
.validation/
*.dump
*.sqlite3
*.key
clean/runtime-images/*.tar
clean/runtime-images/*.tar.gz
